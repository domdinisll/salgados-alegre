{
  "name": "salgados-alegre",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo de loja online Salgados Alegre (React + TypeScript + Tailwind CSS v4).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && npx --yes serve dist -l 4173",
    "serve": "npx --yes serve dist -l 4173",
    "test": "esbuild tests/rules.test.ts --bundle --platform=node --format=esm --outfile=.tmp/rules.test.mjs --log-level=warning && node --test .tmp/rules.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
